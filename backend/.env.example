# SILENT WITNESS - Environment Configuration

# Database
DATABASE_URL=../data/silent_witness.db

# Detection Defaults
SYN_FLOOD_CRITICAL_THRESHOLD=100
SYN_FLOOD_HIGH_THRESHOLD=50
SYN_FLOOD_WINDOW_SECONDS=10

PORT_SCAN_HIGH_THRESHOLD=100
PORT_SCAN_WINDOW_SECONDS=60

ALERT_COOLDOWN_SECONDS=30

# Safety & Response
DRY_RUN_MODE=true
REAL_FIREWALL_ENABLED=false
DEFAULT_BLOCK_DURATION_MINUTES=60
MAX_BLOCKS_PER_HOUR=20

# Server
PORT=8000
HOST=127.0.0.1
